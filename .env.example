# SMTP credentials for /api/contact and the optional visitor notification.
# Contact messages are sent server-side; visitors never need a mail app.
#
# This file only documents the shape of the values; it isn't read directly.
# Set the real values in Vercel → Project → Settings → Environment Variables.

# SMTP server host, e.g. smtp.gmail.com, smtp.zoho.com, smtp.sendgrid.net
SMTP_HOST=

# 587 for STARTTLS (pair with SMTP_SECURE=false), 465 for implicit TLS (SMTP_SECURE=true)
SMTP_PORT=587
SMTP_SECURE=false

# SMTP auth. For Gmail: enable 2-Step Verification, then use an "App Password"
# (myaccount.google.com/apppasswords) here — not your normal Google password.
SMTP_USER=
SMTP_PASS=

# Optional — defaults to SMTP_USER if unset. The address shown as "From".
SMTP_FROM=

# Optional — defaults to the profile email in src/data/profile.ts. Where the
# contact message and "new visitor" notification emails are sent.
NOTIFY_TO_EMAIL=
